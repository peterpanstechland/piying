{
  "name": "shadow-puppet-system",
  "version": "1.0.0",
  "description": "皮影互动系统 - Shadow Puppet Interactive System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "shadow-puppet",
    "interactive",
    "computer-vision",
    "electron"
  ],
  "author": "Your Company",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.shadowpuppet.system",
    "productName": "皮影互动系统",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist_v4",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.html",
      "splash.html",
      "build/**/*"
    ],
    "extraFiles": [
      {
        "from": "../setup-auto-startup.bat",
        "to": "."
      }
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/data",
        "to": "data"
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/ffmpeg.exe",
          "**/ffprobe.exe",
          "**/*.dll"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../admin-frontend/dist",
        "to": "admin-frontend/dist"
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*",
          "!**/*.md"
        ]
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../.env",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "皮影互动系统",
      "license": "build/license.txt",
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "s3",
        "bucket": "your-s3-bucket-name",
        "region": "your-s3-region"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "tree-kill": "^1.2.2"
  }
}
